"! Builds a document showing the features of the library
CLASS zcl_pdf_demo DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    "! @parameter iv_image | Optional JPEG or PNG image to include
    "! @parameter rv_pdf | PDF document
    CLASS-METHODS build
      IMPORTING
        iv_image      TYPE xstring OPTIONAL
      RETURNING
        VALUE(rv_pdf) TYPE xstring
      RAISING
        zcx_pdf_error.

  PRIVATE SECTION.
    CONSTANTS c_margin TYPE f VALUE 50.

    CLASS-METHODS heading
      IMPORTING
        io_page TYPE REF TO zcl_pdf_page
        iv_y    TYPE f
        iv_text TYPE string
      RAISING
        zcx_pdf_error.

    CLASS-METHODS fonts
      IMPORTING
        io_page TYPE REF TO zcl_pdf_page
      RAISING
        zcx_pdf_error.

    CLASS-METHODS shapes
      IMPORTING
        io_page TYPE REF TO zcl_pdf_page
      RAISING
        zcx_pdf_error.

    CLASS-METHODS table
      IMPORTING
        io_page TYPE REF TO zcl_pdf_page
      RAISING
        zcx_pdf_error.

    CLASS-METHODS footers
      IMPORTING
        io_document TYPE REF TO zcl_pdf_document
      RAISING
        zcx_pdf_error.
ENDCLASS.

CLASS zcl_pdf_demo IMPLEMENTATION.

  METHOD build.
    DATA lo_document TYPE REF TO zcl_pdf_document.
    DATA lo_page TYPE REF TO zcl_pdf_page.
    DATA lo_image TYPE REF TO zcl_pdf_image.
    DATA lv_height TYPE f.
    DATA lv_y TYPE f.
    DATA lv_text TYPE string.

    lo_document = zcl_pdf_document=>create( ).
    lo_document->set_title( `abap-pdf demo` )->set_author( `abap-pdf` )->set_subject( `Features of the library` ).

    lo_page = lo_document->add_page( ).

* header bar
    lo_page->set_fill_color( '#1F4E79' ).
    lo_page->rectangle(
      iv_x      = 0
      iv_y      = 0
      iv_width  = lo_page->get_width( )
      iv_height = 90
      iv_style  = zcl_pdf_page=>c_style-fill ).
    lo_page->set_text_color( '#FFFFFF' ).
    lo_page->set_font(
      iv_name = zcl_pdf_font=>c_name-helvetica_bold
      iv_size = 28 ).
    lo_page->text(
      iv_x    = c_margin
      iv_y    = 28
      iv_text = `abap-pdf` ).
    lo_page->set_font(
      iv_name = zcl_pdf_font=>c_name-helvetica
      iv_size = 12 ).
    lo_page->text(
      iv_x     = lo_page->get_width( ) - c_margin
      iv_y     = 40
      iv_text  = `PDF generation in plain ABAP`
      iv_align = zcl_pdf_page=>c_align-right ).

* introduction, justified
    lo_page->set_text_color( '#000000' ).
    lv_text = `This document was generated by abap-pdf, a standalone ABAP library without dependencies. ` &&
      `It supports the standard PDF fonts with exact metrics, text wrapping and alignment, lines, ` &&
      `rectangles, circles, polygons, colors, JPEG and PNG images, links and document metadata. ` &&
      `This paragraph is justified, the text is wrapped at word boundaries to fit the available width.`.
    lv_height = lo_page->text_box(
      iv_x     = c_margin
      iv_y     = 115
      iv_width = lo_page->get_width( ) - 2 * c_margin
      iv_text  = lv_text
      iv_align = zcl_pdf_page=>c_align-justify ).
    lv_y = 115 + lv_height + 15.

* characters outside ASCII, using WinAnsiEncoding
    lv_text = |Special characters: { cl_abap_conv_in_ce=>uccp( '00C6' ) }{ cl_abap_conv_in_ce=>uccp( '00D8' ) }{
      cl_abap_conv_in_ce=>uccp( '00C5' ) } { cl_abap_conv_in_ce=>uccp( '00E4' ) }{ cl_abap_conv_in_ce=>uccp( '00F6' ) }{
      cl_abap_conv_in_ce=>uccp( '00FC' ) }{ cl_abap_conv_in_ce=>uccp( '00DF' ) } { cl_abap_conv_in_ce=>uccp( '00E9' ) }{
      cl_abap_conv_in_ce=>uccp( '00E8' ) }{ cl_abap_conv_in_ce=>uccp( '00F1' ) } { cl_abap_conv_in_ce=>uccp( '20AC' ) } 100 {
      cl_abap_conv_in_ce=>uccp( '2014' ) } { cl_abap_conv_in_ce=>uccp( '201C' ) }quoted{
      cl_abap_conv_in_ce=>uccp( '201D' ) } { cl_abap_conv_in_ce=>uccp( '00A9' ) } 2026|.
    lo_page->text(
      iv_x    = c_margin
      iv_y    = lv_y
      iv_text = lv_text ).

    fonts( lo_page ).
    shapes( lo_page ).

    IF iv_image IS NOT INITIAL.
      lo_image = zcl_pdf_image=>load( iv_image ).
      heading( io_page = lo_page
               iv_y    = 590
               iv_text = `Images` ).
      lo_page->image(
        io_image  = lo_image
        iv_x      = c_margin
        iv_y      = 615
        iv_height = 80 ).
      lo_page->set_font_size( 10 ).
      lo_page->text_box(
        iv_x     = 300
        iv_y     = 615
        iv_width = lo_page->get_width( ) - 300 - c_margin
        iv_text  = |The image is { lo_image->get_width( ) } x { lo_image->get_height( ) } pixels, | &&
                   |scaled to a height of 80 points keeping the aspect ratio.| ).
    ENDIF.

* link
    lo_page->set_font_size( 10 ).
    lo_page->set_text_color( '#0563C1' ).
    lv_text = `https://github.com/larshp/pdf2`.
    lo_page->text(
      iv_x    = c_margin
      iv_y    = 720
      iv_text = lv_text ).
    lo_page->link(
      iv_x      = c_margin
      iv_y      = 720
      iv_width  = lo_page->get_text_width( lv_text )
      iv_height = 12
      iv_url    = lv_text ).
    lo_page->set_text_color( '#000000' ).

    lo_page = lo_document->add_page( iv_landscape = abap_true ).
    table( lo_page ).

    footers( lo_document ).

    rv_pdf = lo_document->render( ).
  ENDMETHOD.

  METHOD heading.
    io_page->set_font(
      iv_name = zcl_pdf_font=>c_name-helvetica_bold
      iv_size = 14 ).
    io_page->set_text_color( '#1F4E79' ).
    io_page->text(
      iv_x    = c_margin
      iv_y    = iv_y
      iv_text = iv_text ).
    io_page->set_stroke_color( '#1F4E79' ).
    io_page->set_line_width( 1 ).
    io_page->line(
      iv_x1 = c_margin
      iv_y1 = iv_y + 18
      iv_x2 = io_page->get_width( ) - c_margin
      iv_y2 = iv_y + 18 ).
    io_page->set_stroke_color( '#000000' ).
    io_page->set_text_color( '#000000' ).
    io_page->set_font(
      iv_name = zcl_pdf_font=>c_name-helvetica
      iv_size = 11 ).
  ENDMETHOD.

  METHOD fonts.
    DATA lt_fonts TYPE string_table.
    DATA lv_font LIKE LINE OF lt_fonts.
    DATA lv_x TYPE f.
    DATA lv_y TYPE f.
    DATA lv_index TYPE i.

    heading( io_page = io_page
             iv_y    = 228
             iv_text = `Standard fonts` ).

    APPEND zcl_pdf_font=>c_name-helvetica TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-times_roman TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-courier TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-helvetica_bold TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-times_bold TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-courier_bold TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-helvetica_oblique TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-times_italic TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-courier_oblique TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-helvetica_bold_oblique TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-times_bold_italic TO lt_fonts.
    APPEND zcl_pdf_font=>c_name-courier_bold_oblique TO lt_fonts.

    lv_y = 258.
    LOOP AT lt_fonts INTO lv_font.
      lv_index = sy-tabix.
      lv_x = c_margin + ( ( lv_index - 1 ) MOD 3 ) * 170.
      io_page->set_font(
        iv_name = lv_font
        iv_size = 11 ).
      io_page->text(
        iv_x    = lv_x
        iv_y    = lv_y
        iv_text = lv_font ).
      IF lv_index MOD 3 = 0.
        lv_y = lv_y + 18.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD shapes.
    DATA lt_points TYPE zcl_pdf_page=>ty_points.
    DATA ls_point LIKE LINE OF lt_points.
    DATA lv_angle TYPE f.
    DATA lv_radius TYPE f.
    DATA lv_index TYPE i.

    heading( io_page = io_page
             iv_y    = 340
             iv_text = `Shapes and colors` ).

    io_page->set_line_width( 2 ).
    io_page->set_stroke_color( '#C00000' ).
    io_page->rectangle(
      iv_x      = c_margin
      iv_y      = 375
      iv_width  = 100
      iv_height = 60 ).

    io_page->set_fill_color( '#FFC000' ).
    io_page->rectangle(
      iv_x      = 170
      iv_y      = 375
      iv_width  = 100
      iv_height = 60
      iv_radius = 12
      iv_style  = zcl_pdf_page=>c_style-fill_stroke ).

    io_page->set_fill_color( '#70AD47' ).
    io_page->circle(
      iv_x      = 330
      iv_y      = 405
      iv_radius = 30
      iv_style  = zcl_pdf_page=>c_style-fill ).

    io_page->set_fill_color( '#5B9BD5' ).
    io_page->ellipse(
      iv_x        = 450
      iv_y        = 405
      iv_radius_x = 50
      iv_radius_y = 25
      iv_style    = zcl_pdf_page=>c_style-fill ).

* five pointed star
    DO 10 TIMES.
      lv_index = sy-index - 1.
      lv_angle = lv_index * 36 * '3.14159265' / 180.
      IF lv_index MOD 2 = 0.
        lv_radius = 40.
      ELSE.
        lv_radius = 16.
      ENDIF.
      ls_point-x = 100 + lv_radius * sin( lv_angle ).
      ls_point-y = 510 - lv_radius * cos( lv_angle ).
      APPEND ls_point TO lt_points.
    ENDDO.
    io_page->set_fill_color( '#7030A0' ).
    io_page->polygon(
      it_points = lt_points
      iv_style  = zcl_pdf_page=>c_style-fill ).

* line styles
    io_page->set_stroke_color( '#000000' ).
    io_page->set_line_width( 1 ).
    io_page->line(
      iv_x1 = 170
      iv_y1 = 480
      iv_x2 = 545
      iv_y2 = 480 ).
    io_page->set_line_dash( 6 ).
    io_page->line(
      iv_x1 = 170
      iv_y1 = 500
      iv_x2 = 545
      iv_y2 = 500 ).
    io_page->set_line_dash(
      iv_dash = 1
      iv_gap  = 3 ).
    io_page->set_line_width( 3 ).
    io_page->line(
      iv_x1 = 170
      iv_y1 = 520
      iv_x2 = 545
      iv_y2 = 520 ).
    io_page->set_line_dash( ).
    io_page->set_line_width( 1 ).

    io_page->set_font_size( 10 ).
    io_page->text_box(
      iv_x     = 170
      iv_y     = 540
      iv_width = 375
      iv_text  = `Lines can be solid or dashed, shapes can be stroked, filled or both.`
      iv_align = zcl_pdf_page=>c_align-center ).
  ENDMETHOD.

  METHOD table.
    DATA lt_rows TYPE string_table.
    DATA lv_row LIKE LINE OF lt_rows.
    DATA lt_cells TYPE string_table.
    DATA lv_cell LIKE LINE OF lt_cells.
    DATA lv_y TYPE f.
    DATA lv_x TYPE f.
    DATA lv_row_height TYPE f.
    DATA lv_cell_height TYPE f.
    DATA lv_width TYPE f.
    DATA lv_column TYPE i.
    DATA lv_padding TYPE f VALUE 5.

    heading( io_page = io_page
             iv_y    = 50
             iv_text = `Tables` ).

    io_page->set_font_size( 10 ).
    io_page->text_box(
      iv_x     = c_margin
      iv_y     = 80
      iv_width = io_page->get_width( ) - 2 * c_margin
      iv_text  = `There is no table element in PDF, tables are built from text boxes and rectangles. ` &&
                 `measure_text_box returns the height of wrapped text, so each row can be as high as its tallest cell.` ).

    APPEND `Material;Description;Quantity;Price` TO lt_rows.
    APPEND `100-100;Casing for the main assembly, aluminium;10;1,250.00` TO lt_rows.
    APPEND `100-200;Screw M6 x 20, stainless steel, DIN 912, delivered in boxes of one hundred;2,500;0.05` TO lt_rows.
    APPEND `100-300;Gasket;40;3.10` TO lt_rows.

    lv_width = ( io_page->get_width( ) - 2 * c_margin ) / 4.
    lv_y = 120.
    io_page->set_stroke_color( '#808080' ).

    LOOP AT lt_rows INTO lv_row.
      IF sy-tabix = 1.
        io_page->set_font(
          iv_name = zcl_pdf_font=>c_name-helvetica_bold
          iv_size = 10 ).
      ELSE.
        io_page->set_font(
          iv_name = zcl_pdf_font=>c_name-helvetica
          iv_size = 10 ).
      ENDIF.

      SPLIT lv_row AT ';' INTO TABLE lt_cells.

      lv_row_height = 0.
      LOOP AT lt_cells INTO lv_cell.
        lv_cell_height = io_page->measure_text_box(
          iv_width = lv_width - 2 * lv_padding
          iv_text  = lv_cell ).
        IF lv_cell_height > lv_row_height.
          lv_row_height = lv_cell_height.
        ENDIF.
      ENDLOOP.
      lv_row_height = lv_row_height + 2 * lv_padding.

      IF lv_row = `Material;Description;Quantity;Price`.
        io_page->set_fill_color( '#DDEBF7' ).
        io_page->rectangle(
          iv_x      = c_margin
          iv_y      = lv_y
          iv_width  = 4 * lv_width
          iv_height = lv_row_height
          iv_style  = zcl_pdf_page=>c_style-fill ).
      ENDIF.

      LOOP AT lt_cells INTO lv_cell.
        lv_column = sy-tabix.
        lv_x = c_margin + ( lv_column - 1 ) * lv_width.
        io_page->rectangle(
          iv_x      = lv_x
          iv_y      = lv_y
          iv_width  = lv_width
          iv_height = lv_row_height ).
        IF lv_column >= 3.
          io_page->text_box(
            iv_x     = lv_x + lv_padding
            iv_y     = lv_y + lv_padding
            iv_width = lv_width - 2 * lv_padding
            iv_text  = lv_cell
            iv_align = zcl_pdf_page=>c_align-right ).
        ELSE.
          io_page->text_box(
            iv_x     = lv_x + lv_padding
            iv_y     = lv_y + lv_padding
            iv_width = lv_width - 2 * lv_padding
            iv_text  = lv_cell ).
        ENDIF.
      ENDLOOP.

      lv_y = lv_y + lv_row_height.
    ENDLOOP.
  ENDMETHOD.

  METHOD footers.
    DATA lo_page TYPE REF TO zcl_pdf_page.
    DATA lv_index TYPE i.

    DO io_document->get_page_count( ) TIMES.
      lv_index = sy-index.
      lo_page = io_document->get_page( lv_index ).
      lo_page->set_font(
        iv_name = zcl_pdf_font=>c_name-helvetica_oblique
        iv_size = 9 ).
      lo_page->set_text_color( '#808080' ).
      lo_page->text(
        iv_x     = lo_page->get_width( ) / 2
        iv_y     = lo_page->get_height( ) - 30
        iv_text  = |Page { lv_index } of { io_document->get_page_count( ) }|
        iv_align = zcl_pdf_page=>c_align-center ).
    ENDDO.
  ENDMETHOD.

ENDCLASS.
